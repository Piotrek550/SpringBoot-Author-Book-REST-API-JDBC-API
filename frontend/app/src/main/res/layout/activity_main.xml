<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/homePage_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:title="Home Page"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <Button
        android:id="@+id/toAuthors_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="30dp"
        android:textSize="20sp"
        android:text="@string/toAuthors_button" />

    <Button
        android:id="@+id/toBooks_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="30dp"
        android:textSize="20sp"
        android:text="@string/toBooks_button"
        android:drawableTop="@drawable/book_icon_48x48" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="bottom"
        android:textAlignment="center"
        android:layout_weight="1"
        android:layout_margin="20dp"
        android:text="@string/copyright_bednarski_i_brzozowski"
        tools:ignore="RtlCompat" />

</LinearLayout>
